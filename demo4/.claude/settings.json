{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/frontend-check.sh",
            "timeout": 90,
            "statusMessage": "oxlint + tsc on the edited frontend file"
          }
        ]
      }
    ]
  }
}
